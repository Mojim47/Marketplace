    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/terminus": "^10.3.0",
    "@nestjs/throttler": "^5.0.0",
    "@nextgen/ai": "workspace:*",
    "@nextgen/auth": "workspace:*",
    "@nextgen/context": "workspace:*",
