{
  "$schema": "./secrets-rotation-policy.schema.json",
  "version": "2026.1",
  "denyByDefault": true,
  "providerRequirements": {
    "vault": ["VAULT_ADDR"],
    "aws": ["AWS_REGION"]
  },
  "requiredSecrets": [
    {
      "name": "DATABASE_URL",
      "rotatedAtEnv": "DATABASE_URL_ROTATED_AT",
      "versionEnv": "DATABASE_URL_SECRET_VERSION",
      "maxAgeDays": 90
    },
    {
      "name": "REDIS_URL",
      "rotatedAtEnv": "REDIS_URL_ROTATED_AT",
      "versionEnv": "REDIS_URL_SECRET_VERSION",
      "maxAgeDays": 90
    },
    {
      "name": "JWT_SECRET",
      "rotatedAtEnv": "JWT_SECRET_ROTATED_AT",
      "versionEnv": "JWT_SECRET_VERSION",
      "maxAgeDays": 90
    }
  ]
}
