{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextgen-marketplace.local/contracts/secrets-rotation-registry.schema.json",
  "title": "Secrets Rotation Registry",
  "type": "object",
  "required": ["version", "runtimeSecrets"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "runtimeSecrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
