{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nextgen-marketplace.local/contracts/secrets-rotation-policy.schema.json",
  "title": "Secrets Rotation Policy",
  "type": "object",
  "required": ["version", "denyByDefault", "requiredSecrets"],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "denyByDefault": {
      "type": "boolean"
    },
    "providerRequirements": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "requiredSecrets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "rotatedAtEnv", "versionEnv", "maxAgeDays"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "rotatedAtEnv": {
            "type": "string",
            "minLength": 1
          },
          "versionEnv": {
            "type": "string",
            "minLength": 1
          },
          "maxAgeDays": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      }
    }
  }
}
