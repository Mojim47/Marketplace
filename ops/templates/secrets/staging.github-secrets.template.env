# GitHub Environment Secrets Template (staging)
# Dummy values only. Do NOT use in real environment.

# Deterministic naming convention:
# NG_<ENV>_<DOMAIN>_<KEY>
# Example: NG_STAGING_RUNTIME_DATABASE_URL

NG_STAGING_RUNTIME_ENV_PRODUCTION_FILE=/etc/nextgen/staging/.env.production
NG_STAGING_RUNTIME_DATABASE_URL=postgresql://nextgen_stage:CHANGE_ME@127.0.0.1:5432/nextgen_stage
NG_STAGING_RUNTIME_REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
NG_STAGING_RUNTIME_API_PORT=3001
NG_STAGING_RUNTIME_JWT_SECRET=CHANGE_ME_TO_A_MINIMUM_32_CHAR_SECRET_VALUE
NG_STAGING_RUNTIME_LOG_FORMAT=json

NG_STAGING_DEPLOY_PROCESS_MANAGER=systemd
NG_STAGING_DEPLOY_SYSTEMD_UNIT=nextgen-api-staging.service
NG_STAGING_DEPLOY_PM2_APP=nextgen-api-staging
NG_STAGING_DEPLOY_PM2_CONFIG=/opt/nextgen/current/ecosystem.config.js

NG_STAGING_OBS_API_BASE_URL=http://127.0.0.1:3001
NG_STAGING_OBS_API_HEALTH_LIVE_URL=http://127.0.0.1:3001/health/live
NG_STAGING_OBS_API_HEALTH_READY_URL=http://127.0.0.1:3001/health/ready
