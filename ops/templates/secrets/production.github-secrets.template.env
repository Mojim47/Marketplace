# GitHub Environment Secrets Template (production)
# Dummy values only. Do NOT use in real environment.

# Deterministic naming convention:
# NG_<ENV>_<DOMAIN>_<KEY>
# Example: NG_PROD_RUNTIME_DATABASE_URL

NG_PROD_RUNTIME_ENV_PRODUCTION_FILE=/etc/nextgen/prod/.env.production
NG_PROD_RUNTIME_DATABASE_URL=postgresql://nextgen_prod:CHANGE_ME@10.10.10.10:5432/nextgen_prod
NG_PROD_RUNTIME_REDIS_URL=redis://:CHANGE_ME@10.10.10.11:6379/0
NG_PROD_RUNTIME_API_PORT=3001
NG_PROD_RUNTIME_JWT_SECRET=CHANGE_ME_TO_A_MINIMUM_32_CHAR_SECRET_VALUE
NG_PROD_RUNTIME_LOG_FORMAT=json

NG_PROD_DEPLOY_PROCESS_MANAGER=systemd
NG_PROD_DEPLOY_SYSTEMD_UNIT=nextgen-api.service
NG_PROD_DEPLOY_PM2_APP=nextgen-api
NG_PROD_DEPLOY_PM2_CONFIG=/opt/nextgen/current/ecosystem.config.js

NG_PROD_OBS_API_BASE_URL=https://api.example.com
NG_PROD_OBS_API_HEALTH_LIVE_URL=https://api.example.com/health/live
NG_PROD_OBS_API_HEALTH_READY_URL=https://api.example.com/health/ready
